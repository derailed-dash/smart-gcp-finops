# Local development configuration loaded by agents-cli
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project
GOOGLE_CLOUD_REGION=your-region
GOOGLE_CLOUD_LOCATION=global

# Billing
GOOGLE_CLOUD_BILLING_ACCOUNT=01234A-5678B-90123C
GOOGLE_CLOUD_BILLING_LOCATION=europe-west4
GOOGLE_CLOUD_BILLING_PROJECT=project-with-billing-export
BILLING_EXPORT_DATASET=all_billing_data

# Local Developer Identity (for local scoping fallbacks)
LOCAL_DEVELOPER_EMAIL=your.name@gmail.com

# Agent Model config
MODEL=gemini-3.6-flash
FAST_MODEL=gemini-3.5-flash-lite

# Org ID for CAI scans
GOOGLE_CLOUD_ORGANIZATION=01234567890

# Root Cause Analysis cost spike threshold (GBP)
# Ignores cost increases below this value during RCA anomalies investigations.
# Use higher thresholds (e.g. 5.0 or 10.0) in production and lower values (e.g. 0.1) in small sandboxes.
RCA_COST_INCREASE_THRESHOLD=0.2

# Spend Analysis Cost Filtering Thresholds (GBP)
# Filters out tiny, negligible rows to prevent dashboard clutter and cache bloat.
SPEND_ANALYSIS_DAILY_COST_THRESHOLD=0.5
SPEND_ANALYSIS_PERIOD_COST_THRESHOLD=2.0
SPEND_ANALYSIS_WASTE_COST_THRESHOLD=0.2
