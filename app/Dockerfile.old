# 1. Use a lightweight Python base image (aligning with your current environment)
FROM python:3.12-slim

# 2. Set the workspace directory
WORKDIR /workspace

# 3. Copy your project's dependency manifest first to leverage Docker build caching
COPY requirements.txt .

# 4. Install dependencies (ensure google-cloud-aiplatform and google-adk are in your requirements.txt)
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copy the rest of your agent's source code
COPY . .

# 6. Expose the standard Cloud Run / Vertex AI port
EXPOSE 8080

# 7. CRITICAL ENTRYPOINT: Run the standard Vertex AI Reasoning Engine web server.
# This ensures that Vertex AI's control plane queries (POST /api/reasoning_engine)
# are successfully received and handled by your ADK agent.
ENTRYPOINT ["python", "-m", "google.cloud.aiplatform.reasoning_engines.web_server"]
